# Copy this file to .env and fill in the values.
# 12-factor: all config lives in the environment, not in code.

# Path to the raw gene-expression CSV (Factor III – Config)
DATASET_PATH=DB.csv

# Where the preprocessed dataset is written
OUTPUT_PATH=processed_data.csv

# Directory where per-model result CSVs are saved (one file per model)
RESULTS_DIR=results

# Directory where per-reduction CSVs are saved (train + test for each method)
REDUCTIONS_DIR=results/reductions

# Name of the target column in the transposed dataset
TARGET_COLUMN=Gleason Group

# Fraction of samples held out for testing  (0 < TEST_SIZE < 1)
TEST_SIZE=0.2

# Seed for reproducible splits and models
RANDOM_STATE=42
